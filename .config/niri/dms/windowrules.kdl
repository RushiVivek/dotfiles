// @id=wr_1774802027506007429 @name=io.github.Qalculate.qalculate-qt
window-rule {
    match app-id="^io.github.Qalculate.qalculate-qt$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

